# FastAPI serves the Vite development server separately by default.
BUILD=development

# Required PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/spade

# Exact comma-separated browser origins allowed to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173

# Authentication sessions expire after this many days.
SESSION_DAYS=7

# Combined RDF data and schema upload limit.
MAX_UPLOAD_BYTES=33554432
