{
  "name": "spade-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "cd .. && uv run python -m backend.export_openapi > /tmp/spade-openapi.json && cd frontend && openapi-typescript /tmp/spade-openapi.json -o src/api/schema.d.ts",
    "api:check": "cd .. && uv run python -m backend.export_openapi > /tmp/spade-openapi.json && cd frontend && openapi-typescript /tmp/spade-openapi.json -o /tmp/spade-schema.d.ts && prettier --write /tmp/spade-schema.d.ts && cmp /tmp/spade-schema.d.ts src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@babel/runtime": "^7.28.6",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@nivo/chord": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@uiw/codemirror-theme-duotone": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@visx/scale": "^4.0.0",
    "@visx/text": "^4.0.0",
    "@visx/wordcloud": "^4.0.0",
    "antd": "^5.29.3",
    "apexcharts": "^7.3.0",
    "axios": "^1.20.0",
    "codemirror": "^6.0.2",
    "leaflet": "^1.9.4",
    "mobx": "^7.0.3",
    "mobx-persist-store": "^1.1.8",
    "mobx-react-lite": "^5.0.3",
    "randomcolor": "^0.6.2",
    "react": "^18.3.1",
    "react-apexcharts": "^2.1.1",
    "react-d3-tree": "^3.6.6",
    "react-dom": "^18.3.1",
    "react-full-screen": "^1.1.1",
    "react-google-charts": "^5.2.1",
    "react-graph-vis": "^1.0.7",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.0",
    "react-vis": "^1.12.1",
    "recharts": "^3.10.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.4",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@types/react-vis": "^1.11.15",
    "@types/vis": "^4.21.27",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.10.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
