{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SPADE: Backend",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "uvicorn",
        "app:app",
        "--reload",
        "--port",
        "5000"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "BUILD": "development"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "spade"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "SPADE: Frontend",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "spade"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "SPADE: Start App",
      "dependsOn": ["SPADE: Backend", "SPADE: Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
